# Copy to .env for local dev. Never commit real values.
NODE_ENV=development
LOG_LEVEL=debug
PORT=8080

ANTHROPIC_API_KEY=

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=

REDIS_URL=redis://localhost:6379
REDIS_FAMILY=4

DATABASE_URL=postgresql://acr:acr@localhost:5432/acr
DIRECT_URL=postgresql://acr:acr@localhost:5432/acr

OIDC_AUDIENCE=ai-reviewer
ALLOWED_OWNERS=your-github-owner

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me
