{
  "name": "autonomous-code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Four Claude specialist agents review every PR in parallel; an LLM judge posts one GitHub review.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eval": "tsx evals/run-eval.ts",
    "db:migrate": "prisma migrate dev",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@bull-board/api": "^9.13.1",
    "@bull-board/fastify": "^9.13.1",
    "@octokit/app": "^16.1.4",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.6",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "web-tree-sitter": "^0.27.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
